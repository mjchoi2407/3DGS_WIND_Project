# Root container ignores the split repositories' contents.
/code/
/ideas/
/experiments/

# Root-local unversioned shared visual scratch. Curated figure sources go to paper/figures/.
/assets/
# Manuscript source allowlist. Root build PDFs and temporary outputs remain ignored.
/paper/*
!/paper/main.tex
!/paper/refs.bib
!/paper/*.tex
!/paper/*.bib
!/paper/*.sty
!/paper/*.cls
!/paper/*.bst
!/paper/figures/
/paper/figures/*
!/paper/figures/.gitkeep
!/paper/figures/*.tex
!/paper/figures/*.svg
!/paper/figures/*.pdf
!/paper/figures/*.png
!/paper/figures/*.jpg
!/paper/figures/*.jpeg
!/paper/sections/
/paper/sections/*
!/paper/sections/.gitkeep
!/paper/sections/*.tex
/external/
/tmp/

# Local environments and caches.
.venv/
venv/
env/
.env
.env.*
!.env.example
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# LaTeX build artifacts.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# Local agent/editor state.
.agents/
.codex
.codex/
.vscode/

# Local installer artifacts and OS noise.
*.deb
*.zip
*.tar
*.tgz
*.tar.gz
*.7z
.DS_Store
Thumbs.db
