{
  "schema_version": "1.0.0",
  "captured_at": "2026-08-13T02:30:00+09:00",
  "owners": {
    "project": [
      "cross-repository manifests",
      "external source patches",
      "workspace governance",
      "paper TeX/Bib 및 선택된 figure source"
    ],
    "code": [
      "reusable Python package",
      "typed schemas",
      "versioned configs",
      "unit and integration tests"
    ],
    "ideas": [
      "canonical method index",
      "idea sketch",
      "implementation checklist",
      "bibliography",
      "prior-direction archive"
    ],
    "experiments": [
      "experiment README and thin wrappers",
      "small deterministic fixtures",
      "compact machine-readable reports",
      "paper evidence summaries"
    ]
  },
  "physical_layout": {
    "versioned_experiment_namespace": "experiments/TD##_short_name/",
    "first_experiment": "experiments/TD00_contracts/",
    "shared_heavy_root": "experiments/artifacts/",
    "heavy_subdirectories": [
      "experiments/artifacts/datasets/",
      "experiments/artifacts/packages/",
      "experiments/artifacts/models/",
      "experiments/artifacts/runs/"
    ],
    "versioned_dataset_inventory": "manifests/datasets.json",
    "external_patch_root": "patches/external/"
  },
  "root_local_scratch": {
    "path": "assets/",
    "tracked": false,
    "role": "공유 시각 자료의 임시 작업 공간",
    "promotion_rule": "논문에 최종 채택한 figure source만 paper/figures/ allowlist로 옮겨 검토 후 추적한다."
  },
  "git_policy": {
    "track": [
      "source code and schemas",
      "configs without secrets",
      "small synthetic fixtures",
      "README and reports",
      "run_manifest.schema.json",
      "external patch files",
      "paper TeX/Bib sources",
      "paper/figures/ 아래 선택된 논문 figure source",
      "secret 값이 없는 .env.example"
    ],
    "do_not_track": [
      "raw public datasets",
      "training checkpoints",
      "large object packages",
      "per-frame renders and videos unless explicitly selected",
      "external build directories",
      "environment caches",
      "secret을 포함할 수 있는 .env와 .env.* 파일",
      "API key, token, credential 및 개인 절대 경로",
      "root assets/ visual scratch",
      "paper/figures/ 밖의 manuscript build PDF",
      "download metadata streams such as Zone.Identifier and mshield"
    ]
  },
  "required_run_manifest_fields": [
    "schema_version",
    "run_id",
    "milestone",
    "created_at",
    "source_repositories",
    "command",
    "working_directory",
    "environment",
    "config_path",
    "config_sha256",
    "seed",
    "device",
    "dataset_id",
    "dataset_sha256_or_manifest_version",
    "object_package_id",
    "object_package_sha256",
    "models",
    "outputs",
    "software",
    "reproducibility_key"
  ],
  "retention_rule": "No large artifact is deleted solely because it is ignored. Verify provenance, final derivative, hash and retrieval rule first, then request explicit deletion approval."
}
